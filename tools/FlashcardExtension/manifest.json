{
  "manifest_version": 3,
  "name": "EnglishTogether - Smart Flashcard",
  "version": "1.2.1",
  "description": "Học từ vựng Tiếng Anh qua Flashcard đồng bộ theo Gmail trên Vercel, gợi ý từ điển thông minh & Popup kiểm tra định kỳ.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Mở EnglishTogether ở cạnh phải trình duyệt",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
